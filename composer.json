{
    "name": "radand/datatablesbundle",
    "type": "symfony-bundle",
    "description": "Symfony Datatable Bundle For Doctrine3 Entities",
    "keywords": ["symfony", "datatable", "datatables", "data-table", "grid", "table", "datagrid", "pagination"],
    "homepage": "https://github.com/stwe/DatatablesBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "stwe"
        },
        {
            "name": "SgDatatablesBundle contributors",
            "homepage": "https://github.com/stwe/DatatablesBundle/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/stwe/DatatablesBundle/issues"
    },
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.0",
        "friendsofsymfony/jsrouting-bundle": "^3.0",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/options-resolver": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/translation": "^8.0",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": { "Sg\\DatatablesBundle\\": "" }
    }
}
